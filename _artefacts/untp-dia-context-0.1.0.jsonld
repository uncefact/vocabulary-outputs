{
  "@context": {
    "untp-dia": "https://test.uncefact.org/vocabulary/untp/dia/0/",
    "untp-core": "https://test.uncefact.org/vocabulary/untp/core/0/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@protected": true,
    "@version": 1.1,
    "RegisteredIdentity": {
      "@protected": true,
      "@id": "untp-dia:RegisteredIdentity",
      "@context": {
        "registeredId": "untp-core:registeredId",
        "idScheme": "untp-core:idScheme",
        "registerType": {
          "@id": "untp-dia:registerType",
          "@type": "@vocab",
          "@context": {
            "@protected": true,
            "@vocab": "https://test.uncefact.org/vocabulary/untp/dia/0/RegistryTypeCodeList#"
          }
        },
        "verifiedDIDList": {
          "@id": "untp-dia:verifiedDIDList",
          "@type": "xsd:string"
        },
        "registrationScopeList": {
          "@id": "untp-dia:registrationScopeList",
          "@type": "xsd:string"
        }
      }
    },
    "DigitalIdentityAnchor": {
      "@protected": true,
      "@id": "untp-dia:DigitalIdentityAnchor",
      "@context": {
        "credentialSubject": {
          "@id": "untp-dia:credentialSubject",
          "@type": "@id"
        }
      }
    },
    "IdentifierScheme": {
      "@protected": true,
      "@id": "untp-core:IdentifierScheme"
    },
    "Identifier": {
      "@protected": true,
      "@id": "untp-core:Identifier",
      "@context": {
        "registeredId": {
          "@id": "untp-core:registeredId",
          "@type": "xsd:string"
        },
        "idScheme": {
          "@id": "untp-core:idScheme",
          "@type": "@id"
        }
      }
    },
    "CredentialIssuer": {
      "@protected": true,
      "@id": "untp-core:CredentialIssuer",
      "@context": {
        "otherIdentifier": {
          "@id": "untp-core:otherIdentifier",
          "@type": "@id"
        }
      }
    }
  }
}