{
  "@context": {
    "untp-dfr": "https://test.uncefact.org/vocabulary/untp/dfr/0/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "untp-core": "https://test.uncefact.org/vocabulary/untp/core/0/"
  },
  "@graph": [
    {
      "@id": "untp-dfr:DigitalFacilityRecord",
      "@type": "rdfs:Class",
      "rdfs:comment": "A digital verifiable credential holding facility performance information.",
      "rdfs:label": "DigitalFacilityRecord",
      "rdfs:subClassOf": "untp-core:VerifiableCredential"
    },
    {
      "@id": "untp-dfr:FacilityClaim",
      "@type": "rdfs:Class",
      "rdfs:comment": "The physical site (eg farm or factory) where the product or materials was produced. Including the facility sustainability performance record.",
      "rdfs:label": "FacilityClaim"
    },
    {
      "@id": "untp-dfr:Claim",
      "@type": "rdfs:Class",
      "rdfs:comment": "A conformity claim about the facility against a specific standard or regulation.",
      "rdfs:label": "Claim",
      "rdfs:subClassOf": "untp-core:Declaration"
    },
    {
      "@id": "untp-dfr:RenderTemplate2024",
      "@type": "rdfs:Class",
      "rdfs:comment": "A single template format focused render method--where the content/media type decision becomes secondary (and is expressed separately).See https://github.com/w3c-ccg/vc-render-method/issues/9",
      "rdfs:label": "RenderTemplate2024",
      "rdfs:subClassOf": "untp-core:RenderTemplate2024"
    },
    {
      "@id": "untp-dfr:WebRenderingTemplate2022",
      "@type": "rdfs:Class",
      "rdfs:comment": "A simple (though non-standard) embedded template.",
      "rdfs:label": "WebRenderingTemplate2022",
      "rdfs:subClassOf": "untp-core:WebRenderingTemplate2022"
    },
    {
      "@id": "untp-dfr:id",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:FacilityClaim"
        },
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "An id is not required in the data but jargon requires for blue class which won't redefine credentialSubject",
        "A unique identifier for the declaration. Often this will be an extension of the product.id or attestation.id. But could be a UUID."
      ],
      "rdfs:label": "id"
    },
    {
      "@id": "untp-dfr:facility",
      "schema:rangeIncludes": {
        "@id": "untp-core:Facility"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:FacilityClaim"
        }
      ],
      "rdfs:comment": [
        "The physical site (eg farm or factory) where the product or materials was produced."
      ],
      "rdfs:label": "facility"
    },
    {
      "@id": "untp-dfr:locationInformation",
      "schema:rangeIncludes": {
        "@id": "untp-core:Location"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:FacilityClaim"
        }
      ],
      "rdfs:comment": [
        "Physical location details"
      ],
      "rdfs:label": "locationInformation"
    },
    {
      "@id": "untp-dfr:conformityClaim",
      "schema:rangeIncludes": {
        "@id": "untp-dfr:Claim"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:FacilityClaim"
        }
      ],
      "rdfs:comment": [
        "A list of conformity declarations against specific criteria from recognised standards or regulations. "
      ],
      "rdfs:label": "conformityClaim"
    },
    {
      "@id": "untp-dfr:referenceStandard",
      "schema:rangeIncludes": {
        "@id": "untp-core:Standard"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the standard that defines the specification / criteria"
      ],
      "rdfs:label": "referenceStandard"
    },
    {
      "@id": "untp-dfr:referenceRegulation",
      "schema:rangeIncludes": {
        "@id": "untp-core:Regulation"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the regulation that defines the assessment criteria"
      ],
      "rdfs:label": "referenceRegulation"
    },
    {
      "@id": "untp-dfr:assessmentCriteria",
      "schema:rangeIncludes": {
        "@id": "untp-core:Criterion"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The specification against which the assessment is made."
      ],
      "rdfs:label": "assessmentCriteria"
    },
    {
      "@id": "untp-dfr:assessmentDate",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The date on which this assessment was made. "
      ],
      "rdfs:label": "assessmentDate"
    },
    {
      "@id": "untp-dfr:declaredValue",
      "schema:rangeIncludes": {
        "@id": "untp-core:Metric"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The list of specific values measured as part of this assessment (eg tensile strength)"
      ],
      "rdfs:label": "declaredValue"
    },
    {
      "@id": "untp-dfr:conformance",
      "schema:rangeIncludes": {
        "@id": "xsd:boolean"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "An indicator of whether or not the claim or assesment conforms to the regulatory or standard criteria."
      ],
      "rdfs:label": "conformance"
    },
    {
      "@id": "untp-dfr:conformityTopic",
      "schema:rangeIncludes": {
        "@id": "untp-dfr:conformityTopicCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The conformity topic category for this assessment (eg vocabulary.uncefact.org/sustainability/emissions)"
      ],
      "rdfs:label": "conformityTopic"
    },
    {
      "@id": "untp-dfr:conformityEvidence",
      "schema:rangeIncludes": {
        "@id": "untp-core:SecureLink"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "A binary file that is hashed ()for tamper evidence) and optionally encrypted (for confidentiality)."
      ],
      "rdfs:label": "conformityEvidence"
    },
    {
      "@id": "untp-dfr:name",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        },
        {
          "@id": "untp-dfr:WebRenderingTemplate2022"
        }
      ],
      "rdfs:comment": [
        "Human facing display name for selection",
        "Human facing display name for template"
      ],
      "rdfs:label": "name"
    },
    {
      "@id": "untp-dfr:mediaQuery",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "Media query as defined in https://www.w3.org/TR/mediaqueries-4/"
      ],
      "rdfs:label": "mediaQuery"
    },
    {
      "@id": "untp-dfr:template",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        },
        {
          "@id": "untp-dfr:WebRenderingTemplate2022"
        }
      ],
      "rdfs:comment": [
        "An inline template field for use cases where remote retrieval of a render method is suboptimal",
        "An inline template field "
      ],
      "rdfs:label": "template"
    },
    {
      "@id": "untp-dfr:url",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "URL for remotely hosted template"
      ],
      "rdfs:label": "url"
    },
    {
      "@id": "untp-dfr:mediaType",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "content/media type for (possible) conneg on the above URL and certainly for display use"
      ],
      "rdfs:label": "mediaType"
    },
    {
      "@id": "untp-dfr:digestMultibase",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "Used for resource integrity and/or validation of the inline `template`"
      ],
      "rdfs:label": "digestMultibase"
    }
  ]
}