{
  "@context": {
    "untp-dfr": "https://test.uncefact.org/vocabulary/untp/dfr/0/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "untp-core": "https://test.uncefact.org/vocabulary/untp/core/0/"
  },
  "@graph": [
    {
      "@id": "untp-dfr:DigitalFacilityRecord",
      "@type": "rdfs:Class",
      "rdfs:comment": "A digital verifiable credential holding facility performance information.",
      "rdfs:label": "DigitalFacilityRecord",
      "rdfs:subClassOf": "untp-core:VerifiableCredential"
    },
    {
      "@id": "untp-dfr:Facility",
      "@type": "rdfs:Class",
      "rdfs:comment": "The physical site (eg farm or factory) where the product or materials was produced. Including the facility sustainability performance record.",
      "rdfs:label": "Facility",
      "rdfs:subClassOf": "untp-core:Facility"
    },
    {
      "@id": "untp-dfr:Claim",
      "@type": "rdfs:Class",
      "rdfs:comment": "A conformity claim about the facility against a specific standard or regulation.",
      "rdfs:label": "Claim",
      "rdfs:subClassOf": "untp-core:Declaration"
    },
    {
      "@id": "untp-dfr:id",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        },
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The globally unique ID of the facility as URI, ideally as a resolvable URL.",
        "A unique identifier for the declaration. Often this will be an extension of the product.id or attestation.id. But could be a UUID."
      ],
      "rdfs:label": "id"
    },
    {
      "@id": "untp-dfr:name",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The registered name of the facility within the identifier scheme.  "
      ],
      "rdfs:label": "name"
    },
    {
      "@id": "untp-dfr:registeredId",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The registration number (alphanumeric) of the facility within the identifier scheme. Unique within the register."
      ],
      "rdfs:label": "registeredId"
    },
    {
      "@id": "untp-dfr:idScheme",
      "schema:rangeIncludes": {
        "@id": "untp-core:IdentifierScheme"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The ID scheme of the facility. eg a GS1 GLN or a National land registry scheme. If self issued then use the party ID of the facility owner. "
      ],
      "rdfs:label": "idScheme"
    },
    {
      "@id": "untp-dfr:description",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "An optional short description of the facility"
      ],
      "rdfs:label": "description"
    },
    {
      "@id": "untp-dfr:countryOfOperation",
      "schema:rangeIncludes": {
        "@id": "untp-dfr:countryCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The country in which this facility is operating."
      ],
      "rdfs:label": "countryOfOperation"
    },
    {
      "@id": "untp-dfr:processCategory",
      "schema:rangeIncludes": {
        "@id": "untp-core:Classification"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The industrial or production processes performed by this facility. Example unstats.un.org/isic/1030."
      ],
      "rdfs:label": "processCategory"
    },
    {
      "@id": "untp-dfr:operatedByParty",
      "schema:rangeIncludes": {
        "@id": "untp-core:Party"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The Party entity responsible for operating the facility.An object structure that uniquely identifies the party within a known party identification scheme. "
      ],
      "rdfs:label": "operatedByParty"
    },
    {
      "@id": "untp-dfr:facilityAlsoKnownAs",
      "schema:rangeIncludes": {
        "@id": "untp-core:Facility"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "An optional list of other registered identifiers for this facility - eg GLNs or other schemes."
      ],
      "rdfs:label": "facilityAlsoKnownAs"
    },
    {
      "@id": "untp-dfr:address",
      "schema:rangeIncludes": {
        "@id": "untp-core:Address"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "The Postal address of the location."
      ],
      "rdfs:label": "address"
    },
    {
      "@id": "untp-dfr:locationInformation",
      "schema:rangeIncludes": {
        "@id": "untp-core:Location"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "Physical location details"
      ],
      "rdfs:label": "locationInformation"
    },
    {
      "@id": "untp-dfr:conformityClaim",
      "schema:rangeIncludes": {
        "@id": "untp-dfr:Claim"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Facility"
        }
      ],
      "rdfs:comment": [
        "A list of conformity declarations against specific criteria from recognised standards or regulations. "
      ],
      "rdfs:label": "conformityClaim"
    },
    {
      "@id": "untp-dfr:referenceStandard",
      "schema:rangeIncludes": {
        "@id": "untp-core:Standard"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the standard that defines the specification / criteria"
      ],
      "rdfs:label": "referenceStandard"
    },
    {
      "@id": "untp-dfr:referenceRegulation",
      "schema:rangeIncludes": {
        "@id": "untp-core:Regulation"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the regulation that defines the assessment criteria"
      ],
      "rdfs:label": "referenceRegulation"
    },
    {
      "@id": "untp-dfr:assessmentCriteria",
      "schema:rangeIncludes": {
        "@id": "untp-core:Criterion"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The specification against which the assessment is made."
      ],
      "rdfs:label": "assessmentCriteria"
    },
    {
      "@id": "untp-dfr:assessmentDate",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The date on which this assessment was made. "
      ],
      "rdfs:label": "assessmentDate"
    },
    {
      "@id": "untp-dfr:declaredValue",
      "schema:rangeIncludes": {
        "@id": "untp-core:Metric"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The list of specific values measured as part of this assessment (eg tensile strength)"
      ],
      "rdfs:label": "declaredValue"
    },
    {
      "@id": "untp-dfr:conformance",
      "schema:rangeIncludes": {
        "@id": "xsd:boolean"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "An indicator of whether or not the claim or assesment conforms to the regulatory or standard criteria."
      ],
      "rdfs:label": "conformance"
    },
    {
      "@id": "untp-dfr:conformityTopic",
      "schema:rangeIncludes": {
        "@id": "untp-dfr:conformityTopicCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "The conformity topic category for this assessment (eg vocabulary.uncefact.org/sustainability/emissions)"
      ],
      "rdfs:label": "conformityTopic"
    },
    {
      "@id": "untp-dfr:conformityEvidence",
      "schema:rangeIncludes": {
        "@id": "untp-core:SecureLink"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dfr:Claim"
        }
      ],
      "rdfs:comment": [
        "A binary file that is hashed ()for tamper evidence) and optionally encrypted (for confidentiality)."
      ],
      "rdfs:label": "conformityEvidence"
    }
  ]
}