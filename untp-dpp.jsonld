{
  "@context": {
    "untp-dpp": "https://test.uncefact.org/vocabulary/untp/dpp/0/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "untp-core": "https://test.uncefact.org/vocabulary/untp/core/0/"
  },
  "@graph": [
    {
      "@id": "untp-dpp:DigitalProductPassport",
      "@type": "rdfs:Class",
      "rdfs:comment": "The Product Passport is a comprehensive data structure that encapsulates various details pertaining to a product, including its identification details, who issued it, batch information, provenance information, circularity information and a set of verifiable product conformity & sustainability claims. ",
      "rdfs:label": "DigitalProductPassport",
      "rdfs:subClassOf": "untp-core:VerifiableCredential"
    },
    {
      "@id": "untp-dpp:Product",
      "@type": "rdfs:Class",
      "rdfs:comment": "The ProductInformation class encapsulates detailed information regarding a specific product, including its identification details, manufacturer, and other pertinent details. ",
      "rdfs:label": "Product",
      "rdfs:subClassOf": "untp-core:Product"
    },
    {
      "@id": "untp-dpp:Claim",
      "@type": "rdfs:Class",
      "rdfs:comment": "A declaration of conformance with one or more criteria from a specific standard or regulation.  ",
      "rdfs:label": "Claim",
      "rdfs:subClassOf": "untp-core:Declaration"
    },
    {
      "@id": "untp-dpp:TraceabilityPerformance",
      "@type": "rdfs:Class",
      "rdfs:comment": "An array of secure links to TraceabilityEvent objects detailing EPCIS events related to the traceability of the product batch. Events are grouped by value chain process (eg \"Weaving\" in textiles supply chain).",
      "rdfs:label": "TraceabilityPerformance"
    },
    {
      "@id": "untp-dpp:RenderTemplate2024",
      "@type": "rdfs:Class",
      "rdfs:comment": "A single template format focused render method--where the content/media type decision becomes secondary (and is expressed separately).See https://github.com/w3c-ccg/vc-render-method/issues/9",
      "rdfs:label": "RenderTemplate2024",
      "rdfs:subClassOf": "untp-core:RenderTemplate2024"
    },
    {
      "@id": "untp-dpp:WebRenderingTemplate2022",
      "@type": "rdfs:Class",
      "rdfs:comment": "A simple (though non-standard) embedded template.",
      "rdfs:label": "WebRenderingTemplate2022",
      "rdfs:subClassOf": "untp-core:WebRenderingTemplate2022"
    },
    {
      "@id": "untp-dpp:id",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        },
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The globally unique ID of the product as a URI. Ideally as a resolvable URL according to ISO 18975. ",
        "A unique identifier for the declaration. Often this will be an extension of the product.id or attestation.id. But could be a UUID."
      ],
      "rdfs:label": "id"
    },
    {
      "@id": "untp-dpp:name",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        },
        {
          "@id": "untp-dpp:RenderTemplate2024"
        },
        {
          "@id": "untp-dpp:WebRenderingTemplate2022"
        }
      ],
      "rdfs:comment": [
        "The registered name of the product within the identifier scheme. ",
        "Human facing display name for selection",
        "Human facing display name for template"
      ],
      "rdfs:label": "name"
    },
    {
      "@id": "untp-dpp:registeredId",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The registration number (alphanumeric) of the entity within the register. Unique within the register."
      ],
      "rdfs:label": "registeredId"
    },
    {
      "@id": "untp-dpp:idScheme",
      "schema:rangeIncludes": {
        "@id": "untp-core:IdentifierScheme"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The identifier scheme for this product.  Eg a GS1 GTIN or an AU Livestock NLIS, or similar. If self issued then use the party ID of the issuer.  "
      ],
      "rdfs:label": "idScheme"
    },
    {
      "@id": "untp-dpp:serialNumber",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A number or code representing a specific serialised item of the product. Unique within product class."
      ],
      "rdfs:label": "serialNumber"
    },
    {
      "@id": "untp-dpp:batchNumber",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "Identifier of the specific production batch of the product.  Unique within the product class."
      ],
      "rdfs:label": "batchNumber"
    },
    {
      "@id": "untp-dpp:productImage",
      "schema:rangeIncludes": {
        "@id": "untp-core:Link"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "Reference information (location, type, name) of an image of the product."
      ],
      "rdfs:label": "productImage"
    },
    {
      "@id": "untp-dpp:description",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A textual description providing details about the product."
      ],
      "rdfs:label": "description"
    },
    {
      "@id": "untp-dpp:productCategory",
      "schema:rangeIncludes": {
        "@id": "untp-core:Classification"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A code representing the product's class, typically using the UN CPC (United Nations Central Product Classification) https://unstats.un.org/unsd/classifications/Econ/cpc"
      ],
      "rdfs:label": "productCategory"
    },
    {
      "@id": "untp-dpp:characteristics",
      "schema:rangeIncludes": {
        "@id": "untp-core:Characteristics"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A placeholder for indusutry / product category specific information.  "
      ],
      "rdfs:label": "characteristics"
    },
    {
      "@id": "untp-dpp:furtherInformation",
      "schema:rangeIncludes": {
        "@id": "untp-core:Link"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A URL pointing to further human readable information about the product."
      ],
      "rdfs:label": "furtherInformation"
    },
    {
      "@id": "untp-dpp:producedByParty",
      "schema:rangeIncludes": {
        "@id": "untp-core:Party"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The Party entity that manufactured the product."
      ],
      "rdfs:label": "producedByParty"
    },
    {
      "@id": "untp-dpp:producedAtFacility",
      "schema:rangeIncludes": {
        "@id": "untp-core:Facility"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The Facility where the product batch was produced / manufactured."
      ],
      "rdfs:label": "producedAtFacility"
    },
    {
      "@id": "untp-dpp:dimensions",
      "schema:rangeIncludes": {
        "@id": "untp-core:Dimension"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The physical dimensions of the product. Not every dimension is relevant to every products.  For example bulk materials may have weight and volume but not length, with, or height.\"weight\":{\"value\":10, \"unit\":\"KGM\"}"
      ],
      "rdfs:label": "dimensions"
    },
    {
      "@id": "untp-dpp:productionDate",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The ISO 8601 date on which the product batch or individual serialised item was manufactured."
      ],
      "rdfs:label": "productionDate"
    },
    {
      "@id": "untp-dpp:countryOfProduction",
      "schema:rangeIncludes": {
        "@id": "untp-dpp:countryCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The country in which this item was produced / manufactured."
      ],
      "rdfs:label": "countryOfProduction"
    },
    {
      "@id": "untp-dpp:granularityLevel",
      "schema:rangeIncludes": {
        "@id": "untp-dpp:granularityCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "Code to indicate the granularity of this digital product passport - item level, batch level or product class level."
      ],
      "rdfs:label": "granularityLevel"
    },
    {
      "@id": "untp-dpp:dueDiligenceDeclaration",
      "schema:rangeIncludes": {
        "@id": "untp-core:Link"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "The due diligence declaration that conforms with the regulations of the market into which the product is sold."
      ],
      "rdfs:label": "dueDiligenceDeclaration"
    },
    {
      "@id": "untp-dpp:materialsProvenance",
      "schema:rangeIncludes": {
        "@id": "untp-core:Material"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "An array of Provenance objects providing details on the origin and mass fraction of components or ingredients of the product batch. "
      ],
      "rdfs:label": "materialsProvenance"
    },
    {
      "@id": "untp-dpp:conformityClaim",
      "schema:rangeIncludes": {
        "@id": "untp-dpp:Claim"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "An array of claim objects representing various product conformity claims about the product / batch.  These can be sustainability claims, circularity claims, or any other claim type within the conformity topic list."
      ],
      "rdfs:label": "conformityClaim"
    },
    {
      "@id": "untp-dpp:circularityScorecard",
      "schema:rangeIncludes": {
        "@id": "untp-core:CircularityPerformance"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "A circularity performance scorecard"
      ],
      "rdfs:label": "circularityScorecard"
    },
    {
      "@id": "untp-dpp:emissionsScorecard",
      "schema:rangeIncludes": {
        "@id": "untp-core:EmissionsPerformance"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "An emissions performance scorecard"
      ],
      "rdfs:label": "emissionsScorecard"
    },
    {
      "@id": "untp-dpp:traceabilityInformation",
      "schema:rangeIncludes": {
        "@id": "untp-dpp:TraceabilityPerformance"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Product"
        }
      ],
      "rdfs:comment": [
        "An array of traceability events grouped by value chain process.  Where actual traceability events are unavailable or carry sensitive information, passport publishers may specify the extent to which the traceability information has been independently verified. "
      ],
      "rdfs:label": "traceabilityInformation"
    },
    {
      "@id": "untp-dpp:assessmentDate",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The date on which this assessment was made. "
      ],
      "rdfs:label": "assessmentDate"
    },
    {
      "@id": "untp-dpp:referenceStandard",
      "schema:rangeIncludes": {
        "@id": "untp-core:referenceStandard"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the standard that defines the specification / criteria"
      ],
      "rdfs:label": "referenceStandard"
    },
    {
      "@id": "untp-dpp:referenceRegulation",
      "schema:rangeIncludes": {
        "@id": "untp-core:referenceRegulation"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The reference to the regulation that defines the assessment criteria"
      ],
      "rdfs:label": "referenceRegulation"
    },
    {
      "@id": "untp-dpp:assessmentCriteria",
      "schema:rangeIncludes": {
        "@id": "untp-core:assessmentCriteria"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The specification against which the assessment is made."
      ],
      "rdfs:label": "assessmentCriteria"
    },
    {
      "@id": "untp-dpp:declaredValue",
      "schema:rangeIncludes": {
        "@id": "untp-core:declaredValue"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The list of specific values measured as part of this assessment (eg tensile strength)"
      ],
      "rdfs:label": "declaredValue"
    },
    {
      "@id": "untp-dpp:conformance",
      "schema:rangeIncludes": {
        "@id": "untp-core:conformance"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "An indicator of whether or not the claim or assesment conforms to the regulatory or standard criteria."
      ],
      "rdfs:label": "conformance"
    },
    {
      "@id": "untp-dpp:conformityTopic",
      "schema:rangeIncludes": {
        "@id": "untp-dpp:conformityTopicCode"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "The conformity topic category for this assessment (eg vocabulary.uncefact.org/sustainability/emissions)"
      ],
      "rdfs:label": "conformityTopic"
    },
    {
      "@id": "untp-dpp:conformityEvidence",
      "schema:rangeIncludes": {
        "@id": "untp-core:SecureLink"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:Claim"
        }
      ],
      "rdfs:comment": [
        "A URI pointing to the evidence supporting the claim. SHOULD be a URL to a UNTP Digital Conformity Credential (DCC)"
      ],
      "rdfs:label": "conformityEvidence"
    },
    {
      "@id": "untp-dpp:valueChainProcess",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:TraceabilityPerformance"
        }
      ],
      "rdfs:comment": [
        "Human readable name for the industry specific value chain process representing this traceability data set."
      ],
      "rdfs:label": "valueChainProcess"
    },
    {
      "@id": "untp-dpp:verifiedRatio",
      "schema:rangeIncludes": {
        "@id": "xsd:decimal"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:TraceabilityPerformance"
        }
      ],
      "rdfs:comment": [
        "The proportion (0 to 1) of materials in this value chain process that have been  traced using verifiable traceability event."
      ],
      "rdfs:label": "verifiedRatio"
    },
    {
      "@id": "untp-dpp:traceabilityEvent",
      "schema:rangeIncludes": {
        "@id": "untp-core:SecureLink"
      },
      "@type": [
        "rdf:Property",
        "owl:ObjectProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:TraceabilityPerformance"
        }
      ],
      "rdfs:comment": [
        "A list of secure links to digital traceability events that support this traceability performance statement. May be encrypted for confidentiality purposes. "
      ],
      "rdfs:label": "traceabilityEvent"
    },
    {
      "@id": "untp-dpp:mediaQuery",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "Media query as defined in https://www.w3.org/TR/mediaqueries-4/"
      ],
      "rdfs:label": "mediaQuery"
    },
    {
      "@id": "untp-dpp:template",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:RenderTemplate2024"
        },
        {
          "@id": "untp-dpp:WebRenderingTemplate2022"
        }
      ],
      "rdfs:comment": [
        "An inline template field for use cases where remote retrieval of a render method is suboptimal",
        "An inline template field "
      ],
      "rdfs:label": "template"
    },
    {
      "@id": "untp-dpp:url",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "URL for remotely hosted template"
      ],
      "rdfs:label": "url"
    },
    {
      "@id": "untp-dpp:mediaType",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "content/media type for (possible) conneg on the above URL and certainly for display use"
      ],
      "rdfs:label": "mediaType"
    },
    {
      "@id": "untp-dpp:digestMultibase",
      "schema:rangeIncludes": {
        "@id": "xsd:string"
      },
      "@type": [
        "rdf:Property",
        "owl:DatatypeProperty"
      ],
      "schema:domainIncludes": [
        {
          "@id": "untp-dpp:RenderTemplate2024"
        }
      ],
      "rdfs:comment": [
        "Used for resource integrity and/or validation of the inline `template`"
      ],
      "rdfs:label": "digestMultibase"
    },
    {
      "@id": "untp-dpp:eventTypeCode",
      "@type": "rdfs:Class",
      "rdfs:label": "eventTypeCode",
      "rdfs:comment": "A code describing the traceability event type - drawn from GS1 EPCIS 2.0"
    },
    {
      "@id": "untp-dpp:eventTypeCode#aggregation",
      "@type": "untp-dpp:eventTypeCode",
      "rdf:value": "aggregation",
      "rdfs:label": "Aggregation event",
      "rdfs:comment": "event describing the grouping of products such as placing bales of cotton on a pallet"
    },
    {
      "@id": "untp-dpp:eventTypeCode#transformation",
